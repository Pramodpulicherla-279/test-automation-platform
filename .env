# # Jira network timeouts (seconds). Keep small so Jira never blocks the run.
# # requests timeout = (connect_timeout, read_timeout)
# JIRA_TIMEOUT_CONNECT_S=3
# JIRA_TIMEOUT_READ_S=7
# JIRA_TIMEOUT_ATTACH_READ_S=15

# # Backend for log streaming
# BACKEND_URL=http://localhost:8000
