# Atlassian Cloud base URL (no trailing slash)
JIRA_URL=https://malothram70.atlassian.net

# Your Atlassian account email
JIRA_EMAIL=malothram70@gmail.com

# API Token from: https://id.atlassian.com/manage-profile/security/api-tokens
JIRA_API_TOKEN=ATATT3xFfGF01m-1RU9YShuYPqOyDyEbWb0B4xs2WM5_KGMxZ0M3vckubf9c-JKmx4kJL3NESA5Hvhk2wsz3hRaXnDJWDIu7u_WKtrrns2pAVmfwoYxpAH_KtPLxpLkOQ3ciJOsSHGd2KciReTPt3hMwNp4BEs_funuNx8PfxttSHXQF16hsvo4=4A929FE2

# Jira project key (e.g. QA, MOBILE, PROJ)
JIRA_PROJECT_KEY=AT

# Issue type: Bug | Task | Story
JIRA_ISSUE_TYPE=Bug

# Priority: Highest | High | Medium | Low | Lowest
JIRA_PRIORITY=High

# Developer's Atlassian account ID to auto-assign bugs (optional)
# Find it: GET /rest/api/3/user/search?query=dev@company.com
JIRA_ASSIGNEE_ACCOUNT_ID=712020:bfa17370-d3ba-489f-a64d-23e909164920

# Master switch — set false to disable all ticket creation
JIRA_ENABLED=true

# Dedup — set false to always create new tickets
JIRA_DEDUP_ENABLED=true

# Jira network timeouts (seconds). Keep small so Jira never blocks the run.
# requests timeout = (connect_timeout, read_timeout)
JIRA_TIMEOUT_CONNECT_S=3
JIRA_TIMEOUT_READ_S=7
JIRA_TIMEOUT_ATTACH_READ_S=15

# Backend for log streaming
BACKEND_URL=http://localhost:8000
```

---

## 🔁 End-to-End Flow Summary
```
pytest run
   │
   ▼
conftest.py::pytest_runtest_makereport()
   │  ├─ check_for_crashes()    → logcat scan
   │  ├─ get_screenshot_as_png()
   │  └─ handle_test_failure()  ← ONE call into jira_integration/
          │
          ▼
    jira_helper.py::handle_test_failure()
          │  └─ _build_full_error(error + crash_log)
          │
          ▼
    jira_service.py::create_or_update_bug()
          │
          ├─ [dedup ON] jira_client.search_issues(JQL)
          │       ├─ FOUND  → jira_client.post_comment()
          │       │           jira_attachment.attach_screenshot()
          │       └─ NOT FOUND ──────────────────────────────────────┐
          │                                                           │
          ▼                                                           │
    jira_mapper.py::build_issue_payload()                            │
          │  └─ formats summary, ADF description, priority, labels   │
          │                                                           │
          ▼                                                           │
    jira_client.py::post_issue()  ←────────────────────────────────-┘
          │  └─ POST /rest/api/3/issue
          │
          ▼
    jira_attachment.py::attach_screenshot()
          │  └─ POST /rest/api/3/issue/{key}/attachments
          │
          ▼
    jira_helper.py  →  allure.attach("Jira Ticket: QA-42")